{
  "name": "cherryz-webshare",
  "version": "0.1.0",
  "private": true,
  "description": "Cherryz WebShare - A modern file sharing server inspired by Berryz WebShare",
  "scripts": {
    "dev": "turbo run dev --filter=@cherryz/api",
    "dev:manager": "turbo run dev --filter=@cherryz/manager",
    "dev:viewer": "turbo run dev --filter=@cherryz/viewer",
    "dev:all": "turbo run dev",
    "build": "turbo run build --filter=@cherryz/api",
    "build:manager": "turbo run build --filter=@cherryz/manager",
    "build:viewer": "turbo run build --filter=@cherryz/viewer",
    "build:all": "turbo run build",
    "type-check": "turbo run type-check",
    "clean": "turbo run clean && rm -rf node_modules .turbo",
    "start": "pnpm --filter @cherryz/api start",
    "update-deps": "ncu -u && pnpm install"
  },
  "keywords": [
    "file-sharing",
    "webshare",
    "file-management",
    "monorepo"
  ],
  "author": "",
  "license": "MIT",
  "packageManager": "pnpm@10.18.3",
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=9.0.0"
  },
  "devDependencies": {
    "npm-check-updates": "^19.1.1",
    "turbo": "^2.5.8"
  }
}
