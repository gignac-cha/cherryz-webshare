{
  "name": "cherryz-webshare",
  "version": "0.1.0",
  "private": true,
  "description": "Cherryz WebShare - A modern file sharing server inspired by Berryz WebShare",
  "scripts": {
    "dev": "pnpm --filter @cherryz/api dev",
    "dev:manager": "pnpm --filter @cherryz/manager dev",
    "dev:viewer": "pnpm --filter @cherryz/viewer dev",
    "dev:all": "pnpm --parallel --filter @cherryz/* dev",
    "build": "pnpm --filter @cherryz/api build",
    "build:manager": "pnpm --filter @cherryz/manager build",
    "build:viewer": "pnpm --filter @cherryz/viewer build",
    "build:all": "pnpm --filter @cherryz/* build",
    "start": "pnpm --filter @cherryz/api start",
    "update-deps": "ncu -u && pnpm install"
  },
  "keywords": [
    "file-sharing",
    "webshare",
    "file-management",
    "monorepo"
  ],
  "author": "",
  "license": "MIT",
  "packageManager": "pnpm@10.18.3",
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=9.0.0"
  },
  "devDependencies": {
    "npm-check-updates": "^19.1.1"
  }
}
