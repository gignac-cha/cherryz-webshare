{
  "name": "cherryz-webshare",
  "version": "0.1.0",
  "private": true,
  "description": "Cherryz WebShare - A modern file sharing server inspired by Berryz WebShare",
  "scripts": {
    "dev": "pnpm --filter @cherryz/api dev",
    "build": "pnpm --filter @cherryz/api build",
    "start": "pnpm --filter @cherryz/api start",
    "update-deps": "ncu -u && pnpm install"
  },
  "keywords": [
    "file-sharing",
    "webshare",
    "file-management",
    "monorepo"
  ],
  "author": "",
  "license": "MIT",
  "packageManager": "pnpm@9.15.4",
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=9.0.0"
  },
  "devDependencies": {
    "npm-check-updates": "^17.1.14"
  }
}
